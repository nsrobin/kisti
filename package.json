{
  "name": "kisti",
  "version": "1.0.0",
  "description": "Kisti (কিস্তি): an offline loan & EMI calculator and installment tracker for Bangladesh, in Bengali and English.",
  "private": true,
  "license": "MIT",
  "author": "Md. Nazmus Shakib",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "link:assets": "npx react-native-asset",
    "build:android": "cd android && ./gradlew bundleRelease",
    "build:android:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bootsplash": "^7.3.4",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.1",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
