  "stitch": {
    "base": {
      "dash": 8,
      "gap": 6,
      "stroke": 3,
      "cap": "round"
    },
    "ring": {
      "radius": "size/2 - size*0.07",
      "perStitch": "2πR/units",
      "stroke": "clamp(per*0.42, size*0.016, size*0.032)",
      "arc": "max(per*0.6 - stroke, 0.4)  (visible length = arc + stroke because of round caps)",
      "units": "n <= 120 ? n : ceil(n/12) (one stitch per year; last partial year drawn at half length)",
      "track": "1px line circle under the stitches",
      "dueGlow": "aurora stroke at stroke*2.8, opacity 0.25↔0.55"
    },
    "linear": {
      "units": "n <= 60 ? n : ceil(n/12)",
      "stroke": "clamp(per*0.5, 2.6, 6)",
      "arc": "max(per*0.62 - stroke, 0.3)",
      "height": 10
    },
    "colors": {
      "paid": "money.cash",
      "due": "money.emi + aurora glow, 2 s pulse",
      "upcoming": "money.principal @ 0.45",
      "final": "money.interest knot dot 8",
      "outside": "text.muted @ 0.30"
    },
    "calendarMarks": {
      "paid": {
        "w": 22,
        "h": 6,
        "fill": "money.cash"
      },
      "due": {
        "w": 16,
        "h": 16,
        "ring": 2.5,
        "color": "money.emi",
        "glow": "0 0 10 aurora1@0.6, 0 0 16 aurora2@0.35"
      },
      "upcoming": {
        "w": 22,
        "h": 6,
        "outline": 1.5,
        "color": "money.principal@0.45"
      },
      "final": {
        "dot": 8,
        "color": "money.interest",
        "placement": "after the status mark"
      },
      "outside": {
        "w": 22,
        "h": 6,
        "fill": "text.muted",
        "cellOpacity": 0.3
      }
    }
  },
